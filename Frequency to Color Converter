module FrequencyToColorConverter(
    input clk,
    input reset,
    input done_color,
    input [31:0] red,
    input [31:0] green,
    input [31:0] blue,
    output reg [2:0] rgb_output = 3'b000,
    output reg [2:0] stored_value = 3'b000
);

    parameter TOLERANCE = 100;
    parameter RED_THRESH = 100;
    parameter GREEN_THRESH = 50;// chnage this threshold
    parameter BLUE_THRESH = 150;
    parameter MIN_COUNT = 16;
    
    reg [4:0] red_count = 0;
    reg [4:0] blue_count = 0;
    reg [4:0] green_count = 0;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            rgb_output <= 3'b000;
          //  stored_value = rgb_output; make stored_value be the same value as rgb_output
        end else if (done_color) begin
            if ((red > green + TOLERANCE) && (red > blue + TOLERANCE) && red > RED_THRESH) begin
                red_count = red_count + 1;
                blue_count = 0;
                green_count = 0;
                if(red_count >= MIN_COUNT) begin
                    rgb_output <= 3'b100; // Red is dominant
                end
            end else if ((green > red + TOLERANCE) && (green > blue + TOLERANCE) && green > GREEN_THRESH) begin
                green_count = green_count + 1;
                blue_count = 0;
                red_count = 0;
                if(green_count >= MIN_COUNT) begin
                    rgb_output <= 3'b010; // Red is dominant
                end
            end else if ((blue > red + TOLERANCE) && (blue > green + TOLERANCE) && blue > BLUE_THRESH) begin
                blue_count = blue_count + 1;
                red_count = 0;
                green_count = 0;
                if(blue_count >= MIN_COUNT) begin
                    rgb_output <= 3'b001; // Red is dominant
                end
            end else begin
                red_count = 0;
                blue_count = 0;
                green_count = 0;
                rgb_output <= 3'b000; // No dominant color detected
            end
        end
    end
endmodule
