module motor_control(
    input clk,                    // Clock
    input start,      
    input [1:0]IR_sensor,   
    input [1:0] color_count,  
    input [2:0]rgb_desired,
    input [2:0]rgb_output,    
    input [2:0]psensor, 
    output reg emit,
    output reg claw,   
    output reg LIN1,  
    output reg LIN2,
    output reg RIN1,
    output reg RIN2,
    output pwm_left,              // PWM output for left motor speed control
    output pwm_right
    );
    reg [26:0]counter;
    reg [26:0]delay_timer1=27'd100000000;
    reg [26:0]delay_timer2=27'd50000000;
    reg [26:0]claw_delay=27'd20000000;
    reg [16:0]dutycycle_left;  
    reg [16:0]dutycycle_right;
    reg [4:0] mode_select;
    reg [2:0] mode;
    reg [2:0] motor_control;
    reg [1:0] color_order;
    reg [1:0] temp_mode;
    reg [1:0] delay_mode;
    reg turn_detect;
    reg [1:0] turn_count;
    reg [1:0] turn_ignore;
    reg [1:0]return_turn_ignore;
    reg Turn180;
    reg Lturn90;
    reg Rturn90;
    reg delivered;
        pwm_simple_IPS #(.WIDTH(17)) pwm_left_module (
        .clk(clk),
        .start(start),
        .duty(dutycycle_left),
        .pwm_out(pwm_left)
    );
   pwm_simple_IPS #(.WIDTH(17)) pwm_right_module (
        .clk(clk),
        .start(start),
        .duty(dutycycle_right),
        .pwm_out(pwm_right)
    );
    initial 
    begin
        Turn180=0;
        Lturn90=0;
        Rturn90=0;
        turn_count=0;
        delivered=0; 
    end
    always@(posedge clk)begin
       mode_select={delivered, color_count[1],color_count[0], IR_sensor[1], IR_sensor[0]};
    end
    ////////////////////////////////////////////////////////////////////////////////////////////
    localparam State1=2'b00, State2=2'b01, State3=2'b10, State4=2'b11;
    localparam BLANK_STATE = 3'b111,FORWARD_STATE = 3'b101, Ladj_STATE = 3'b011, Radj_STATE = 3'b110, L90_STATE=3'b001, R90_STATE=3'b100,FORWARD_STATE1=3'b000,Left_Turn_State=3'b000;
    localparam T180_STATE= 3'b000;  
    ////////////////////////////////////////////////////////////////////////////////////////////
     always @(posedge clk ) begin
        if (!Turn180&&!Lturn90&&!Rturn90) 
        begin
            counter <= 0;
            motor_control<=psensor;
            mode<=temp_mode;
            
        end 
        else if (Turn180||Lturn90||Rturn90)
        begin
            counter <= counter + 1;       
        if (Turn180&&!Lturn90&&!Rturn90)
        begin
//claw implmentationn logic

    if (counter < claw_delay) begin
        claw_open = 1;  
    end else begin
        claw_open = 0;  
    end
            if(counter<delay_timer1&&counter>claw_delay)
            begin
                motor_control<=T180_STATE;
                mode<=delay_mode;
            end
            else
            begin
            Turn180=0;
            end
        end
        if (!Turn180&&Lturn90&&!Rturn90)
        begin
            if(counter<delay_timer2)
            begin
            motor_control<=L90_STATE;
            end
            else
            begin
            Lturn90=0;
            end
        end
        if (!Turn180&&!Lturn90&&Rturn90)
        begin
            if(counter<delay_timer2)
            begin
            motor_control<=R90_STATE;
            end
            else
            begin
            Rturn90=0;
            end
        end    
        end
    end
//////////////////////////////////////////////////////////////////////////////////////////////////////
always@(posedge turn_detect)
    begin
    turn_count<=turn_count+1;
    end
/////////////////////////////////////////////////////////////////////////////////////////////////////
always@(posedge clk)
    begin
    case(mode)
        State1:
        begin
          case (motor_control[2:0])
            FORWARD_STATE: begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;
            end
            FORWARD_STATE1: begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0; 
            end
            Ladj_STATE: begin
            dutycycle_left = 17'd65536;   //50% duty cycle. 
            dutycycle_right = 17'd98304;  //75% duty cycle.   
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;    
            end
            Radj_STATE: begin
            dutycycle_left = 17'd98304;  
            dutycycle_right = 17'd65536;  
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;                        
            end
            3'b111: begin  
            dutycycle_left = 17'd98304;
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;        
            end
            L90_STATE: begin
            dutycycle_left = 17'd98304; 
            dutycycle_right =17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;          
            end
            R90_STATE: begin
            dutycycle_left = 17'd98304;  
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;        
            end      
           default :
           begin
            dutycycle_left = 17'd0;
            dutycycle_right = 17'd0;
            LIN1=0;
            RIN1=0;
            LIN2=0;
            RIN2=0;            
            end
        endcase
        end
        State2:
        begin
        case(motor_control)
        BLANK_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;
        end
        FORWARD_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;
        end
        Ladj_STATE:
        begin
            dutycycle_left = 17'd65536;   //50% duty cycle. 
            dutycycle_right = 17'd98304;  //75% duty cycle.   
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;  
        end
        Radj_STATE:
        begin
            dutycycle_left = 17'd98304;  
            dutycycle_right = 17'd65536;  
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0; 
        end
        L90_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=0;
            RIN1=1;
            LIN2=1;
            RIN2=0;
            Lturn90=1;
        end
        R90_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=0;
            LIN2=0;
            RIN2=1;
            Rturn90=1;
        end
        T180_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=0;
            Turn180=0;
        end
        default: 
        begin
            dutycycle_left = 17'd0;  
            dutycycle_right = 17'd0;
            LIN1=0;
            RIN1=0;
            LIN2=0;
            RIN2=0;
        end
    endcase
        end
    State3:
    begin
    case(motor_control)
        default:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=0;
            LIN2=0;
            RIN2=1;
         end    
         endcase
    end
    State4:
    begin
    case(motor_control)
        BLANK_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1;
        end
        FORWARD_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1;
        end
        Ladj_STATE:
        begin
            dutycycle_left = 17'd65536;   //50% duty cycle. 
            dutycycle_right = 17'd98304;  //75% duty cycle.   
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1;  
        end
        Radj_STATE:
        begin
            dutycycle_left = 17'd98304;  
            dutycycle_right = 17'd65536;  
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1; 
        end
        L90_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1;
        end
        R90_STATE:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=0;
            RIN1=0;
            LIN2=1;
            RIN2=1;
        end
        Left_Turn_State:
        begin
            dutycycle_left = 17'd98304; //75% duty cycle. 
            dutycycle_right = 17'd98304;
            LIN1=1;
            RIN1=1;
            LIN2=0;
            RIN2=1;
        end
        default: 
        begin
            dutycycle_left = 17'd0;  
            dutycycle_right = 17'd0;
            LIN1=0;
            RIN1=0;
            LIN2=0;
            RIN2=0;
        end
    endcase
    end
    endcase
    case(mode_select)
        5'b00011:
        begin
            temp_mode<=State1;
        end
        5'b00010:
        begin
            dutycycle_left = 17'd0;  
            dutycycle_right = 17'd0;
            LIN1=0;
            RIN1=0;
            LIN2=0;
            RIN2=0;
            emit=1;
        end
        5'b00001:
        begin
            temp_mode<=State2;   
        end
        5'b00000:
        begin
            Turn180=1;
            emit=0;
            delay_mode=2'b10;
        end
        5'b00101:
        begin
        temp_mode<=State2;
        if(rgb_output==rgb_desired)
            begin
            delivered=1;
            end
        if(psensor==3'b001||psensor==3'b100)
            begin
            turn_detect=1;
            end
            else
            begin
            turn_detect=0;
            end
        end
        5'b01001:
        begin
            
            turn_ignore=2'b10;
            if(turn_count<turn_ignore)
            begin
               temp_mode<=State1;
            end
            if(turn_count==turn_ignore)
            begin
                temp_mode<=State2;
                if(rgb_output==rgb_desired)
                begin
                    delivered=1;
                end
            end
        end
        5'b01101:
        begin
            turn_ignore=2'b11;
            if(turn_count<turn_ignore)
            begin
                temp_mode<=State1;
            end
            if(turn_count==turn_ignore)
                begin
                temp_mode<=State2;
                if(rgb_output==rgb_desired) begin
                    delivered=1;
                end
            end
        end
        5'b10101:
        begin
            claw=0;
        end
        5'b11001:
        begin
            claw=0;
        end
        5'b11101:
        begin
            claw=0;
            turn_count=0;
            return_turn_ignore=2'b10;
        end  
        5'b10111:
        begin
            temp_mode<=State4;
        end
        5'b11011:
        begin
            temp_mode<=State4;
        end
        5'b11111:
        begin  
            if(turn_count==return_turn_ignore)
            begin
                temp_mode<=State2;
            end
        else
            begin        
                temp_mode<=State4;
            end
        end
    endcase
    end
endmodule
